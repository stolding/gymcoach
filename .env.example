# Optioneel: instellingen voor GymCoach (wordt gelezen door de systemd-dienst)
# PORT=8765
# HOST=0.0.0.0
# Achter een reverse proxy (Apache/nginx op een VPS):
# TRUST_PROXY=1
# TZ=Europe/Amsterdam

# Reverse SSH-tunnel naar een VPS (deploy/tunnel)
# GYMCOACH_VPS_HOST=vps.example.com
# GYMCOACH_VPS_USER=root
# GYMCOACH_VPS_KEY=/home/<gebruiker>/.ssh/id_ed25519
# GYMCOACH_VPS_TUNNEL_PORT=18765
